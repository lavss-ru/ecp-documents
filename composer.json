{
	"name": "lavss/ecp-documents",
	"description": "WordPress plugin for managing PDF documents with electronic signatures.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"autoload": {
		"psr-4": {
			"Lavss\\ECPDocuments\\": "src/"
		}
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.13",
		"wp-coding-standards/wpcs": "^3.4"
	},
	"scripts": {
		"phpcs": "phpcs --standard=WordPress .",
		"phpcbf": "phpcbf --standard=WordPress ."
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
